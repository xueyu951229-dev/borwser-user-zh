# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# For Chinese candidates using PackyAPI proxy:
# ANTHROPIC_BASE_URL=https://your-proxy-url.com

# Port Configuration (optional - defaults shown)
# NOTE: VNC and noVNC ports are now per-session (dynamically allocated).
# Only the API port is fixed for the main backend.
API_PORT=8000

# Session Container Configuration (optional - defaults shown)
# Port range for per-session noVNC host mappings
# NOVNC_PORT_MIN=6081
# NOVNC_PORT_MAX=6180
# Session container image
# SESSION_IMAGE=browser-use-demo:latest
# Docker network for session containers
# SESSION_NETWORK=browser-use-net
# Resource limits per session container
# SESSION_MEM_LIMIT=2g
# SESSION_CPU_QUOTA=50000

# MySQL Database Configuration (optional - defaults shown)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=browseruse
MYSQL_PASSWORD=password
MYSQL_DB=browseruse
MYSQL_ROOT_PASSWORD=rootpassword