# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# For Chinese candidates using PackyAPI proxy:
# ANTHROPIC_BASE_URL=https://your-proxy-url.com

# Port Configuration (optional - defaults shown)
VNC_PORT=5900
NOVNC_PORT=6080
HTTP_PORT=8080
API_PORT=8000

# MySQL Database Configuration (optional - defaults shown)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=browseruse
MYSQL_PASSWORD=password
MYSQL_DB=browseruse
MYSQL_ROOT_PASSWORD=rootpassword